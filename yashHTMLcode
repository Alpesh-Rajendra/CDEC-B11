          <div class="output">Select a command below.</div>
        </div>
      </div>

      <div class="toolbar" style="margin-top:14px">
        <button class="secondary" onclick="runCommand('git')">Git</button>
        <button class="secondary" onclick="runCommand('docker')">Docker</button>
        <button class="secondary" onclick="runCommand('aws')">AWS CLI</button>
        <button class="secondary" onclick="runCommand('linux')">Linux</button>
      </div>
    </div>

  </section>

  <section class="section card">
    <h2>🛠 DevOps Toolkit</h2>
