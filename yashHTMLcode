<script>
const stages = ["s1", "s2", "s3", "s4"];
let pipelineRunning = false;
let pipelineToken = 0;

function setStage(id, text, pending = false) {
  const element = document.getElementById(id);
  element.textContent = text;
  element.className = pending ? "status pending" : "status";
}

function sleep(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

async function runPipeline() {
  if (pipelineRunning) return;

  pipelineRunning = true;
  const token = ++pipelineToken;
  const button = document.getElementById("deployBtn");
  button.disabled = true;
  button.textContent = "⏳ Pipeline Running...";

  const labels = ["Source", "Test & Build", "Docker", "Deploy"];
  const messages = [
    "Fetching source code...",
    "Running tests and preparing build...",
    "Building simulated Docker image...",
    "Simulating application deployment..."
  ];

  stages.forEach(id => setStage(id, "WAITING", true));
  document.getElementById("progressBar").style.width = "0%";

  for (let i = 0; i < stages.length; i++) {
    if (token !== pipelineToken) return;

    setStage(stages[i], "RUNNING", true);
    document.getElementById("pipelineMessage").textContent =
      labels[i] + ": " + messages[i];

    await sleep(900);

    if (token !== pipelineToken) return;

    setStage(stages[i], "SUCCESS");
    document.getElementById("progressBar").style.width =
      ((i + 1) * 25) + "%";
  }

  document.getElementById("pipelineMessage").textContent =
    "✓ Demo pipeline completed successfully!";

  pipelineRunning = false;
  button.disabled = false;
  button.textContent = "▶ Run Pipeline";
}

function resetPipeline() {
  pipelineToken++;
  pipelineRunning = false;

  stages.forEach((id, i) => {
    setStage(id, i === 0 ? "READY" : "WAITING", i !== 0);
  });

  document.getElementById("progressBar").style.width = "0%";
  document.getElementById("pipelineMessage").textContent =
    "Pipeline reset. Ready for another demo.";

  const button = document.getElementById("deployBtn");
  button.disabled = false;
  button.textContent = "▶ Run Pipeline";
}

const commands = {
  git: [
    "$ git status",
    "On branch main",
    "Your working tree is clean.",
    "",
    "$ git log -1 --oneline",
    "a1b2c3d Demo commit (example)"
  ],
  docker: [
    "$ docker ps",
    "CONTAINER ID   IMAGE       STATUS",
    "demo123        nginx       Up (example)",
    "",
    "Note: simulated output; Docker was not executed."
  ],
  aws: [
    "$ aws sts get-caller-identity",
    "Demo output only.",
    "Configure AWS CLI and credentials to run this command.",
    "No AWS API request was sent."
  ],
  linux: [
    "$ uptime",
    "up 2 days, 3 hours (example)",
    "",
    "$ df -h",
    "Filesystem usage output (example)",
    "Note: simulated output; Linux was not queried."
  ]
};

function runCommand(type) {
  const terminal = document.getElementById("terminalOutput");
  terminal.innerHTML = "";

  commands[type].forEach(line => {
    const row = document.createElement("div");
    row.className = line.startsWith("$") ? "prompt" : "output";
    row.textContent = line || "\u00a0";
    terminal.appendChild(row);
  });
}
</script>

